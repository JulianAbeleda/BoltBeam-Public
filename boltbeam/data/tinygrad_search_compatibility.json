{
  "schema": "boltbeam.cross_repo_compatibility.v1",
  "provider": "tinygrad",
  "entrypoint": "extra/llm_research/search_provider.py",
  "command": ["python3", "extra/llm_research/search_provider.py", "--backend", "METAL"],
  "required_interfaces": {
    "provider_protocol": "tinygrad.search_provider.v1",
    "provider_actions": ["describe", "admit", "compile", "check", "measure"],
    "boltbeam_readable_candidate_versions": ["boltbeam.full_kernel_candidate.v1", "boltbeam.full_kernel_candidate.v2"],
    "provider_executable_candidate_versions": ["boltbeam.full_kernel_candidate.v2"],
    "resolved_target": "boltbeam.resolved_target.v1",
    "search_request": "boltbeam.full_kernel_search_request.v1",
    "search_result": "boltbeam.full_kernel_search_result.v1"
  },
  "runtime_pins": {
    "boltbeam_request_field": "requested_boltbeam_revision",
    "provider_request_field": "requested_provider_revision",
    "provider_payload_field": "provider_identity"
  },
  "execution_contract": {
    "request_field": "execution",
    "provider_payload_fields": ["fixture_shape", "warmups", "samples"],
    "shape_modes": {
      "exact_workload": {
        "required_fields": ["shape_mode", "warmups", "samples"],
        "fixture_shape_source": "candidate.workload.shape"
      },
      "bounded_fixture": {
        "required_fields": ["shape_mode", "fixture_shape", "warmups", "samples"],
        "fixture_shape_source": "execution.fixture_shape"
      }
    }
  }
}
