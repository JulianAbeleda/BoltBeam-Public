      "requires_replay": false,
      "requires_root_or_privilege": false,
      "supports_dispatch_timing": true,
      "supports_kernel_resources": false,
      "supports_dynamic_counters": false,
      "supports_memory_copy": false,
      "supports_allocations": false,
