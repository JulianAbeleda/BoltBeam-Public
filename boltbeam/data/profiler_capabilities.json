      "known_blind_spots": [
        "Metal System Trace exposes command-buffer intervals but does not export per-dispatch shader duration in this capture mode.",
        "Runtime stdout remains the authority for measured token throughput and fixed-depth workload identity."
      ],
      "calibration_notes": [
        "Use the same trace template, fixed-depth protocol, target, and model hash for every provider in a comparison.",
        "Command-buffer rows are diagnostic attribution and must not be summed across overlapping concurrent buffers."
      ]
    },
    {
      "provider_id": "llama.cpp",
      "provider_support": [
        "llama.cpp"
      ],
      "collector_id": "metal-native",
      "tool": "Metal.framework via ctypes + llama-bench",
      "tool_version": "macOS Metal 3+",
      "operation": "capture",
      "selection_priority": 100,
      "target_support": [
        "apple_metal",
        "apple_m3_10c",
        "apple_m4_10c"
