        "per_kernel_timing_of_llama_cpp",
        "registers",
        "occupancy_pct",
        "correctness"
      ],
      "known_blind_spots": [
        "Whole step only: no kernel rows and no probe evidence. BoltBeam's probe kernels are Metal only.",
        "Per-kernel llama.cpp time on NVIDIA needs the vendor profiler (collect-hw-trace --provider llama)."
      ],
      "calibration_notes": [
        "Whole-step tokens per second is llama-bench decode at the requested depth; nothing else stands in for it.",
        "llama-bench is found by --llama-bench, then $BOLTBEAM_LLAMA_BENCH, then PATH."
      ]
    }
