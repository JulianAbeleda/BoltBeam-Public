  "layer2": {
    "glossary": [
      {
        "plain": "Tokens a second: how many words (or pieces of words) the model writes each second. Higher is faster.",
        "term": "tok/s"
      },
      {
        "plain": "The fastest this GPU allows for this model: the time to move every byte the step needs once at the GPU's memory speed (or, for heavy maths, at its top compute speed). A real run is always slower.",
        "term": "limit"
      },
      {
        "plain": "Milliseconds: thousandths of a second.",
        "term": "ms"
      },
      {
        "plain": "How many tokens of conversation the model already holds when it writes the next one. More context means more to read.",
        "term": "context"
      },
      {
        "plain": "One piece of the model's work in each step, such as the feed-forward or attention layers, or the time between GPU steps.",
        "term": "part"
      },
      {
        "plain": "How long this part takes now, in each token (or each step of several streams, or each prompt).",
        "term": "time"
      },
      {
        "plain": "This part's share of the lost time: of all the time the run takes beyond the limit, how much is in this part.",
        "term": "share"
      },
      {
        "plain": "What this part would give back if it ran at its own limit: its share of the distance from the measured speed to the limit.",
        "term": "gain"
      },
      {
        "plain": "The speed with this part and every part above it fixed.",
        "term": "cumulative"
      },
      {
        "plain": "A part's time now, less its time at the limit.",
        "term": "time lost"
      },
      {
        "plain": "The fastest this kind of work can run on this GPU by any method, not only the engine's.",
        "term": "chip best"
      },
      {
        "plain": "How much of the GPU's top memory speed a part reaches while it runs.",
        "term": "% of peak"
      },
      {
        "plain": "Gigabytes a second: how fast memory is read.",
        "term": "GB/s"
      },
      {
        "plain": "Time between GPU kernels, when the GPU waits for the next piece of work.",
        "term": "idle time"
      },
      {
        "plain": "A tool that watches the GPU and notes when every kernel starts and ends. Watching slows the run a little.",
        "term": "recording"
      },
      {
        "plain": "The run with no recording tool attached: the speed the engine really has.",
        "term": "untraced"
      },
      {
        "plain": "The same setup run several times, so a later change can be told apart from normal variation.",
        "term": "repeat runs"
      },
      {
        "plain": "How the model's numbers are stored: fewer bits per number means less to read and a faster step, at some cost in accuracy.",
        "term": "quant"
      },
      {
        "plain": "What the model keeps about earlier tokens (keys and values), read again for every new token.",
        "term": "KV cache"
      },
